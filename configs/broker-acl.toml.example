# PUBLISH grants are exact names. SUBSCRIBE grants are literal requested filters,
# including +/#; e.g. subscribe = ["sensores/+/temperatura"].
# Any omitted user/topic/action is denied. # does not include $ topics.
# MQTT topics are created by publishing: no separate topic creation step.
[[rules]]
username = "lab-device"
publish = ["teste/mensagem"]
subscribe = ["teste/mensagem"]
