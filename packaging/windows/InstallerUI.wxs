<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="XmqrInstallerUI">
      <TextStyle Id="XmqrUIFont" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="XmqrUIFont" />
      <Property Id="ErrorDialog" Value="XmqrErrorDlg" />

      <Dialog Id="XmqrRemoveDlg" Width="370" Height="200" Title="Desinstalar [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="28"
            Text="Deseja desinstalar [ProductName]?" />
        <Control Id="Info" Type="Text" X="25" Y="58" Width="320" Height="90"
            Text="O Windows Installer remover&#xE1; somente [ProductName]. Os arquivos de configura&#xE7;&#xE3;o, certificados, logs e dados em ProgramData ser&#xE3;o preservados. Os demais produtos XMQR continuar&#xE3;o instalados." />
        <Control Id="Remove" Type="PushButton" X="198" Y="170" Width="88" Height="17" Text="Desinstalar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="299" Y="170" Width="58" Height="17"
            Default="yes" Cancel="yes" Text="Cancelar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrWelcomeDlg" Width="370" Height="270" Title="Instala&#xE7;&#xE3;o de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="18" Width="330" Height="32"
            Text="Bem-vindo &#xE0; instala&#xE7;&#xE3;o de [ProductName]" />
        <Control Id="PackageInfo" Type="Text" X="25" Y="62" Width="320" Height="84"
            Text="Este assistente instalar&#xE1; [ProductName]. Broker, Client e Admin s&#xE3;o servi&#xE7;os Windows e n&#xE3;o abrem uma janela. O instalador n&#xE3;o inicia o servi&#xE7;o durante esta instala&#xE7;&#xE3;o; configure os arquivos privados antes de inici&#xE1;-lo. O Manager, quando instalado, abre na pr&#xF3;xima entrada no Windows." />
        <Control Id="StartMenuChoice" Type="CheckBox" X="25" Y="157" Width="320" Height="17"
            Property="XMQR_START_MENU" CheckBoxValue="1" Text="Criar atalho no menu Iniciar" />
        <Control Id="DesktopChoice" Type="CheckBox" X="25" Y="181" Width="320" Height="17"
            Property="XMQR_DESKTOP" CheckBoxValue="1" Text="Criar atalho na &#xE1;rea de trabalho" />
        <Control Id="AcceptLicense" Type="CheckBox" X="25" Y="205" Width="240" Height="17"
            Property="XMQR_ACCEPT_LICENSE" CheckBoxValue="1" Text="Li e aceito os termos de licen&#xE7;a" />
        <Control Id="ReadTerms" Type="PushButton" X="273" Y="203" Width="84" Height="20"
            Text="Ler termos">
          <Publish Event="SpawnDialog" Value="XmqrTermsDlg" />
        </Control>
        <Control Id="Divider" Type="Line" X="0" Y="230" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="232" Y="243" Width="58" Height="17"
            Default="yes" Disabled="yes" Text="&amp;Instalar"
            EnableCondition="XMQR_ACCEPT_LICENSE = &quot;1&quot; OR Installed OR REMOVE = &quot;ALL&quot;"
            DisableCondition="NOT (XMQR_ACCEPT_LICENSE = &quot;1&quot; OR Installed OR REMOVE = &quot;ALL&quot;)">
          <Publish Event="EndDialog" Value="Return" Condition="XMQR_ACCEPT_LICENSE = &quot;1&quot; OR Installed OR REMOVE = &quot;ALL&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="299" Y="243" Width="58" Height="17"
            Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="XmqrCancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrTermsDlg" Width="370" Height="270" Title="Termos de licen&#xE7;a de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="14" Width="330" Height="24"
            Text="Termos de licen&#xE7;a de [ProductName]" />
        <Control Id="TermsText" Type="ScrollableText" X="20" Y="43" Width="330" Height="177"
            Sunken="yes">
          <Text SourceFile="$(sys.SOURCEFILEDIR)TERMS.pt-BR.rtf" />
        </Control>
        <Control Id="Close" Type="PushButton" X="299" Y="239" Width="58" Height="17"
            Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrProgressDlg" Width="370" Height="150" Title="[ProductName]" Modeless="yes">
        <Control Id="ActionText" Type="Text" X="20" Y="20" Width="330" Height="20">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="50" Width="330" Height="15"
            ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="ActionData" Type="Text" X="20" Y="77" Width="330" Height="35">
          <Subscribe Event="ActionData" Attribute="Text" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="299" Y="120" Width="58" Height="17"
            Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="XmqrCancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrExitDlg" Width="370" Height="150" Title="[ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
            Text="A opera&#xE7;&#xE3;o foi conclu&#xED;da" />
        <Control Id="CompletionInfo" Type="Text" X="25" Y="57" Width="320" Height="54"
            Text="Se instalou um servi&#xE7;o, configure os arquivos privados e inicie-o pela bandeja do XMQR Manager. Ele est&#xE1; configurado para iniciar com o Windows; prepare os arquivos antes do pr&#xF3;ximo boot. Os atalhos escolhidos foram criados quando dispon&#xED;veis. A remo&#xE7;&#xE3;o preserva os dados em ProgramData." />
        <Control Id="Finish" Type="PushButton" X="299" Y="120" Width="58" Height="17"
            Default="yes" Text="Concluir">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrCancelledDlg" Width="370" Height="150" Title="Instala&#xE7;&#xE3;o cancelada">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
            Text="A instala&#xE7;&#xE3;o foi cancelada" />
        <Control Id="Info" Type="Text" X="25" Y="57" Width="320" Height="54"
            Text="O Windows Installer encerrou a opera&#xE7;&#xE3;o. Se a instala&#xE7;&#xE3;o j&#xE1; havia come&#xE7;ado, consulte o log para confirmar o resultado da revers&#xE3;o." />
        <Control Id="Close" Type="PushButton" X="299" Y="120" Width="58" Height="17"
            Default="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrFatalDlg" Width="370" Height="150" Title="Erro na instala&#xE7;&#xE3;o do XMQR">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25"
            Text="N&#xE3;o foi poss&#xED;vel concluir a instala&#xE7;&#xE3;o" />
        <Control Id="Info" Type="Text" X="25" Y="57" Width="320" Height="54"
            Text="O Windows Installer encerrou com erro. Consulte o log da instala&#xE7;&#xE3;o para ver a mensagem e o c&#xF3;digo do erro: [MsiLogFileLocation]" />
        <Control Id="Close" Type="PushButton" X="299" Y="120" Width="58" Height="17"
            Default="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrErrorDlg" Width="370" Height="150" Title="Erro do Windows Installer" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="20" Width="330" Height="75" TabSkip="no"
            Text="[Error]" />
        <Control Id="Y" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="Sim">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="A" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="Abortar">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="Cancelar">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="Ignorar">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="N&#xE3;o">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="300" Y="120" Width="58" Height="17" Text="Tentar novamente">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
      </Dialog>

      <Dialog Id="XmqrCancelDlg" Width="280" Height="100" Title="Cancelar instala&#xE7;&#xE3;o">
        <Control Id="Question" Type="Text" X="20" Y="15" Width="240" Height="32"
            Text="Deseja realmente cancelar a opera&#xE7;&#xE3;o?" />
        <Control Id="Yes" Type="PushButton" X="142" Y="69" Width="58" Height="17"
            Default="yes" Text="Sim">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="210" Y="69" Width="58" Height="17"
            Cancel="yes" Text="N&#xE3;o">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>

    <InstallUISequence>
      <Show Dialog="XmqrWelcomeDlg" Before="XmqrRemoveDlg" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Show Dialog="XmqrRemoveDlg" Before="XmqrProgressDlg" Condition="REMOVE = &quot;ALL&quot;" />
      <Show Dialog="XmqrProgressDlg" Before="ExecuteAction" Condition="1" />
      <Show Dialog="XmqrExitDlg" OnExit="success" />
      <Show Dialog="XmqrCancelledDlg" OnExit="cancel" />
      <Show Dialog="XmqrFatalDlg" OnExit="error" />
    </InstallUISequence>
  </Fragment>
</Wix>
