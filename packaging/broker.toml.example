version = 1
[limits]
max_connections = 64
max_sessions = 64
max_retained = 256
max_subscriptions = 256
max_offline = 64
max_inflight = 32
[broker]
mode = "secure-mtls"
bind = "0.0.0.0:8883"
# Somente mode = "open-lab": ws_bind = "127.0.0.1:8083" (caminho /mqtt)
state_dir = "/var/lib/xmqr"
# server_keep_alive_seconds = 60 # MQTT 5: teto opcional, 1..65535
[tls]
server_cert = "/etc/xmqr/server.crt"
server_key = "/etc/xmqr/server.key"
client_ca = "/etc/xmqr/clients-ca.crt"
[security]
bundle = "/etc/xmqr/security.toml"
[monitor]
enabled = false
bind = "127.0.0.1:9090"
